{
  "manifest_version": 3,
  "name": "BB Better Layout for Adamson",
  "version": "2.5.1",
  "description": "Improve Adamson University's Blackboard with cleaner navigation, course banners, reading themes, and keyboard shortcuts.",
  "permissions": ["storage"],
  "icons":{
    "16":"icons/bbicon_16x16.png",
    "32":"icons/bbicon_32x32.png",
    "48":"icons/bbicon_48x48.png",
    "128":"icons/bbicon_128x128.png"
  },
  "action": {
    "default_icon":{
      "16":"icons/bbicon_16x16.png",
      "32":"icons/bbicon_32x32.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://adamson.blackboard.com/*"],
      "css": ["styles.css"],
      "js": ["shortcuts.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
