{
  "manifest_version": 3,
  "name": "BB Better Layout",
  "version": "2.11.0",
  "description": "Improve Blackboard Ultra with cleaner navigation, course banners, reading themes, shortcuts, study notes, and custom links.",
  "permissions": ["storage"],
  "icons":{
    "16":"icons/bbicon_16x16.png",
    "32":"icons/bbicon_32x32.png",
    "48":"icons/bbicon_48x48.png",
    "128":"icons/bbicon_128x128.png"
  },
  "action": {
    "default_icon":{
      "16":"icons/bbicon_16x16.png",
      "32":"icons/bbicon_32x32.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://*.blackboard.com/*"],
      "css": ["styles.css", "study-note/study-note.css"],
      "js": [
        "shortcuts.js",
        "utils.js",
        "custom-links/config.js",
        "study-note/storage.js",
        "study-note/import-export.js",
        "study-note/app.js",
        "theme.js",
        "course-cover.js",
        "banner.js",
        "sidebar.js",
        "group-space.js",
        "back-to-top.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
